# Neon pooled URL used by the running API (`-pooler` in the hostname).
DATABASE_URL=postgresql://USER:PASSWORD@EP-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connection_limit=10

# Neon direct URL used by Prisma migrations and other CLI operations.
DIRECT_URL=postgresql://USER:PASSWORD@EP-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# Generate these separately. Each value must be at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret

# Exact website origin. Do not include a trailing slash.
FRONTEND_URL=https://example.com

# Only used by `npm run db:seed` to create the first administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# WhatsApp alert to the admin for every new order (Meta WhatsApp Business Cloud API).
# Leave the token/phone ID empty to keep it off — orders work normally and admin shows "WhatsApp not set up".
# Setup steps and the message template to register: see backend/WHATSAPP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_NUMBER=916300836017
WHATSAPP_MESSAGE_MODE=template
WHATSAPP_ORDER_TEMPLATE=new_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
