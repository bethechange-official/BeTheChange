generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum UserRole {
  CUSTOMER
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(320)
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@map("admins")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(320)
  passwordHash String
  phone        String?   @db.VarChar(30)
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model Product {
  id                String         @id @default(uuid()) @db.Uuid
  name              String         @db.VarChar(180)
  slug              String         @unique @db.VarChar(200)
  shortDescription  String?        @db.VarChar(500)
  description       String?
  price             Decimal        @db.Decimal(12, 2)
  originalPrice     Decimal?       @db.Decimal(12, 2)
  category          String         @db.VarChar(120)
  collection        String?        @db.VarChar(120)
  skinConcern       String?        @db.VarChar(120)
  size              String?        @db.VarChar(80)
  stock             Int            @default(0)
  ingredients       String?
  benefits          String?
  usageInstructions String?
  isFeatured        Boolean        @default(false)
  isActive          Boolean        @default(true)
  images            ProductImage[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  categoryRel       Category       @relation("ProductCategory", fields: [category], references: [name], onUpdate: Cascade, onDelete: Restrict)
  collectionRel     Collection?    @relation("ProductCollection", fields: [collection], references: [name], onUpdate: Cascade, onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([category, isActive])
  @@index([collection, isActive])
  @@index([skinConcern])
  @@index([isFeatured, isActive])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?  @db.VarChar(250)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @db.Uuid
  sessionId String?    @unique @db.Uuid
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Coupon {
  id                    String       @id @default(uuid()) @db.Uuid
  code                  String       @unique @db.VarChar(50)
  description           String?
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(12, 2)
  minimumOrderAmount    Decimal      @default(0) @db.Decimal(12, 2)
  maximumDiscountAmount Decimal?     @db.Decimal(12, 2)
  startDate             DateTime
  expiryDate            DateTime
  usageLimit            Int
  usedCount             Int          @default(0)
  isActive              Boolean      @default(true)
  orders                Order[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([isActive, startDate, expiryDate])
  @@map("coupons")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[] @relation("ProductCategory")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@map("categories")
}

model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[] @relation("ProductCollection")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@map("collections")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(120)
  phone        String   @db.VarChar(30)
  addressLine1 String   @db.VarChar(250)
  addressLine2 String?  @db.VarChar(250)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(100)
  pincode      String   @db.VarChar(12)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isDefault])
  @@map("addresses")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  orderNumber    String        @unique @db.VarChar(40)
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String        @db.VarChar(120)
  customerEmail  String        @db.VarChar(320)
  customerPhone  String        @db.VarChar(30)
  addressName    String        @db.VarChar(120)
  addressPhone   String        @db.VarChar(30)
  addressLine1   String        @db.VarChar(250)
  addressLine2   String?       @db.VarChar(250)
  city           String        @db.VarChar(100)
  state          String        @db.VarChar(100)
  pincode        String        @db.VarChar(12)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  couponId       String?       @db.Uuid
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?       @db.VarChar(50)
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(PENDING)
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  productId   String?  @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @db.VarChar(180)
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  image       String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(320)
  phone     String?  @db.VarChar(30)
  subject   String?  @db.VarChar(200)
  message   String
  status    String   @default("NEW") @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contacts")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
